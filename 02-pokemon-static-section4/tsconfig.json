{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@pages/*": ["src/pages/*"],
      "@styles/*": ["src/styles/*"],
      "@utils/*": ["src/utils/*"],
      "@assets/*": ["src/assets/*"],
      "@types/*": ["src/types/*"],
      "@content/*": ["src/content/*"],
      "@stores/*": ["src/stores/*"],
      "@hooks/*": ["src/hooks/*"],
      "@images/*": ["src/assets/images/*"],
      "@data/*": ["src/data/*"],
      "@services/*": ["src/services/*"],
      "@tests/*": ["src/tests/*"],
      "@astro/*": ["src/astro/*"],
      "@interfaces/*": ["src/interfaces/*"],
      "@consts/*": ["src/consts/*"],
    },
    "types": ["astro/client"]
  }
}